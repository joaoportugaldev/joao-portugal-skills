{
  "version": 1,
  "defaults": {
    "namespace": "@my-org",
    "appsDir": "apps",
    "modulesDir": "modules",
    "packagesDir": "packages",
    "sharedModulePath": "packages/shared",
    "sharedSubmoduleUrl": "https://github.com/joaoportugaldev/shared.git",
    "frontendAppPath": "apps/frontend",
    "backendAppPath": "apps/backend",
    "frontendPort": 3000,
    "backendPort": 4000,
    "frontendApiUrlEnvVar": "NEXT_PUBLIC_API_URL",
    "backendPortEnvVar": "PORT"
  }
}
